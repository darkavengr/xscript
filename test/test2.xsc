function len(lenstr as string) as integer																																		
declare count as integer

count=0

repeat
	count=count+1		# test comment
until lenstr[count] != ""

return count
endfunction

function instr_x(start as integer,mainstr as string,substr as string) as integer
declare size as integer

count=0

print len(substr)

while count < 5
	print mainstr[count,count+len(substr)],count,count+len(substr)

#	if count+len(substr) > len(mainstr) then	# no more to match
#		exit for
#	endif

	if mainstr[count,count+len(substr)] = substr then	# if sub-string found
		print "EEEEEEvil"
		return count				# return position
	endif

count=count+1
wend

return -1			# sub-string not found
endfunction

print instr_x(0,"Hello","He")

