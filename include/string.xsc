#
# Get string length
#
# In: str	String
#
# Returns: string length
#
function len(lenstr as string) as integer																																		
declare count as integer

count=0

while lenstr[count] != ""
	count=count+1		# test comment
wend		

count=count+2

return count
endfunction


#
# Fill string with characters
#
# In: fillstring	String to fill with
#     num		Number of times to fill
#
# Returns: string containing <count> characters starting from the end of the string
#
#
function fillstring(fillstr as string,num as integer) as string
outstr=""

for count=0 to num
	outstr=outstr+fillstr
next count

return outstr
endfunction

#
# Return substring position in string
#
# In: start		Starting character position
#     str		String
#     substr		Sub-string to search for
#
# Returns: position of the sub-string or -1 if not found
#
#
function instr(start as integer,str as string,substr as string) as integer
for count=start to len(str)
	if str[count,count+len(str)] == substr) then	# if sub-string found
		return count				# return position
	endif

return -1			# sub-string not found
endfunction

#
# Return hexadecimal representation of a number
#
# In: number		Number
#
# Returns: string containing hexadecimal representation of a number
#
function hex(number as integer) as string
declare hexbuf(16) as string
declare mask as integer
declare count as integer
declare index as integer
declare shiftamount as integer
declare foundend as boolean

hexbuf(0)="0"
hexbuf(1)="1"
hexbuf(2)="2"
hexbuf(3)="3"
hexbuf(4)="4"
hexbuf(5)="5"
hexbuf(6)="6"
hexbuf(7)="7"
hexbuf(8)="8"
hexbuf(9)="8"
hexbuf(10)="A"
hexbuf(11)="B"
hexbuf(12)="C"
hexbuf(13)="D"
hexbuf(14)="E"
hexbuf(15)="F"

outstring=""
mask=0xf						# Initial bit mask
shiftamount=0
foundend=False

for count=0 to 4			# For each nibble
	index=(number & mask) >> shiftamount  			# get the nibble

	if index != 0 then
		foundend=True
	endif


	shiftamount=shiftamount + 4
	mask=mask << 4

	if foundend = True and index = 0 then
		exit for
	endif
	
	outstring=hexbuf(index)+outstring
next count

return outstring		
endfunction

#
# Return octal representation of a number
#
# In: number		Number
#
# Returns: string containing octal representation of a number
#
function oct(number as integer) as string
declare octbuf(8) as string
declare mask as integer
declare count as integer
declare index as integer
declare shiftamount as integer
declare foundend as boolean

octbuf(0)="0"
octbuf(1)="1"
octbuf(2)="2"
octbuf(3)="3"
octbuf(4)="4"
octbuf(5)="5"
octbuf(6)="6"
octbuf(7)="7"

outstring=""
mask=7						# Initial bit mask
shiftamount=0
foundend=False

for count=0 to 10			# For each nibble
	index=(number & mask) >> shiftamount  			# get the nibble
	if index != 0 then
		foundend=True
	endif


	shiftamount=shiftamount + 3
	mask=mask << 3

	if foundend = True and index = 0 then
		exit for
	endif
	
	outstring=octbuf(index)+outstring
next count

return outstring		
endfunction

#
# Remove trailing spaces from string
#
# In: string	String to process
#
# Returns: string without leading spaces
#
function rtrim(str as string) as string
declare outstring as string
declare pos as integer

pos=len(str)

# find first non-space character

while pos > 1
	if str[pos,1] == " " then		# skip spaces
		pos=pos-1
	else					# found non-space character
		exit while
	endif
wend

# copy rest of string

for count=1 to pos
	outstring=outstring + str[count]
next count

return outstring
endfunction

function reverse(reversestr as string) as string							
count=len(reversestr)

revstr=""

repeat
	revstr=revstr+reversestr[count]
	
	count=count-1
until count = -1

return revstr
endfunction

function str(num as integer) as string
declare valdigits(10) as string
declare outstr as string

valdigits(0)="0"
valdigits(1)="1"
valdigits(2)="2"
valdigits(3)="3"
valdigits(4)="4"
valdigits(5)="5"
valdigits(6)="6"
valdigits(7)="7"
valdigits(8)="8"
valdigits(9)="9"

outstr=""

while num > 0
	outstr=outstr+valdigits(num % 10)
	num=num / 10
wend

return reverse(outstr)
endfunction

#
# Convert string into integer
#
# In: numstr	string to convert
#
# Returns: integer representation of the number
#

function val(numstr as string) as integer
declare shiftamount as integer
declare outnum as integer
declare count as integer
declare digitcount as integer
declare valdigits(10) as string

valdigits(0)="0"
valdigits(1)="1"
valdigits(2)="2"
valdigits(3)="3"
valdigits(4)="4"
valdigits(5)="5"
valdigits(6)="6"
valdigits(7)="7"
valdigits(8)="8"
valdigits(9)="9"

shiftamount=1

count=0

for count=len(numstr) to 0 step -1
	for digitcount=0 to 9
		if valdigits(digitcount) = numstr[count] then
			outnum=outnum+(digitcount*shiftamount)

			shiftamount=shiftamount * 10			
			exit for
		endif
	next digitcount
next count																																					

return outnum
endfunction

